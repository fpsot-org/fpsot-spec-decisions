        {
          "@value": "Correction",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The body corrected an error in an earlier record.",
          "@language": "en"
        },
        {
          "@value": "L’organisme a corrigé une erreur dans un enregistrement antérieur.",
          "@language": "fr"
        }
      ]
    },

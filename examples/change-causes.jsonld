        {
          "@value": "Reprocessing",
          "@language": "en"
        },
        {
          "@value": "Retraitement",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The service ran the decision again, such as after new inputs arrived.",
          "@language": "en"
        },
        {
          "@value": "Le service a traité la décision de nouveau, par exemple après l’arrivée de nouveaux intrants.",

      "skos:definition": [
        {
          "@value": "A review step led to the new record (DEC-061).",
          "@language": "en"
        },
        {
          "@value": "Une étape de révision a mené au nouvel enregistrement (DEC-061).",
          "@language": "fr"
        }
      ]
    },

        },
        {
          "@value": "Réexamen",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The person asked the body to reconsider the decision.",
          "@language": "en"
        },
        {
          "@value": "La personne a demandé à l’organisme de réexaminer la décision.",
          "@language": "fr"
        }
      ]
    },

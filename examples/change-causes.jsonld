      "skos:definition": [
        {
          "@value": "Synthetic example of a scheme of change causes of the FPSOT decisions specification (DEC-043). Each code says why a record revises an earlier one.",
          "@language": "en"
        },
        {
          "@value": "Exemple synthétique d’un schéma de causes de modification de la spécification FPSOT sur les décisions (DEC-043). Chaque code dit pourquoi un enregistrement en révise un plus ancien.",
          "@language": "fr"
        }
      ],

        }
      ],
      "skos:definition": [
        {
          "@value": "A body that hears appeals changed or confirmed the decision.",
          "@language": "en"
        },
        {
          "@value": "Une instance d’appel a modifié ou confirmé la décision.",
          "@language": "fr"
        }
      ]

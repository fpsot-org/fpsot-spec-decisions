          "@value": "Rectified input",
          "@language": "en"
        },
        {
          "@value": "Intrant rectifié",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The person or the body rectified a fact that the decision used (DEC-047).",
          "@language": "en"
        },
        {
          "@value": "La personne ou l’organisme a rectifié un fait que la décision a utilisé (DEC-047).",
          "@language": "fr"
        }
      ]
    },

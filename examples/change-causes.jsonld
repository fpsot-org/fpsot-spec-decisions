        },
        {
          "@value": "Loi rétroactive",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "A rule version with retroactive effect changed the result (DEC-036).",
          "@language": "en"
        },
        {
          "@value": "Une version de règles à effet rétroactif a changé le résultat (DEC-036).",
          "@language": "fr"
        }
      ]
    },

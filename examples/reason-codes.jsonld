  },
  "@graph": [
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons",
      "@type": "skos:ConceptScheme",
      "owl:versionInfo": "1.0.0",
      "dct:license": {"@id": "https://spdx.org/licenses/Community-Spec-1.0"},
      "skos:prefLabel": [
        {"@value": "Reasons for example housing benefit decisions", "@language": "en"},
        {"@value": "Motifs des décisions sur l’allocation de logement d’exemple", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "Synthetic example of a reason scheme of the FPSOT decisions specification (DEC-050). Each code names a factor of the decision.", "@language": "en"},
        {"@value": "Exemple synthétique d’un schéma de motifs de la spécification FPSOT sur les décisions (DEC-050). Chaque code nomme un facteur de la décision.", "@language": "fr"}
      ],
      "skos:hasTopConcept": [
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-income-above-limit"},
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-size"},
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-income-missing"},
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/residence-outside-program-area"},
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/hardship-exception"},
        {"@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/other"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-income-above-limit",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "household-income-above-limit",
      "skos:prefLabel": [
        {"@value": "Household income above the limit", "@language": "en"},
        {"@value": "Revenu du ménage supérieur à la limite", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "The income of the household is higher than the limit for its size.", "@language": "en"},
        {"@value": "Le revenu du ménage dépasse la limite qui s’applique à sa taille.", "@language": "fr"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-size",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "household-size",
      "skos:prefLabel": [
        {"@value": "Household size", "@language": "en"},
        {"@value": "Taille du ménage", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "The number of persons in the household, which sets the income limit that applies.", "@language": "en"},
        {"@value": "Le nombre de personnes du ménage, qui fixe la limite de revenu applicable.", "@language": "fr"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/household-income-missing",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "household-income-missing",
      "skos:prefLabel": [
        {"@value": "Household income missing", "@language": "en"},
        {"@value": "Revenu du ménage manquant", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "The file holds no household income, which the rules need to compute the result.", "@language": "en"},
        {"@value": "Le dossier ne contient pas le revenu du ménage, dont les règles ont besoin pour calculer le résultat.", "@language": "fr"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/residence-outside-program-area",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "residence-outside-program-area",
      "skos:prefLabel": [
        {"@value": "Residence outside the program area", "@language": "en"},
        {"@value": "Résidence hors du territoire du programme", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "The household does not live in the area that the program covers.", "@language": "en"},
        {"@value": "Le ménage n’habite pas sur le territoire que couvre le programme.", "@language": "fr"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/hardship-exception",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "hardship-exception",
      "skos:prefLabel": [
        {"@value": "Hardship exception", "@language": "en"},
        {"@value": "Exception pour situation difficile", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "A person with the power to do so set the result aside because of the hardship of the household.", "@language": "en"},
        {"@value": "Une personne qui en a le pouvoir a écarté le résultat en raison de la situation difficile du ménage.", "@language": "fr"}
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-reasons/concepts/other",
      "@type": "skos:Concept",
      "skos:inScheme": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:topConceptOf": {"@id": "https://vocab.example.org/example-housing-benefit-reasons"},
      "skos:notation": "other",
      "skos:prefLabel": [
        {"@value": "Other reason", "@language": "en"},
        {"@value": "Autre motif", "@language": "fr"}
      ],
      "skos:definition": [
        {"@value": "A reason that no other code names. A person states it in English and in French (DEC-054).", "@language": "en"},
        {"@value": "Un motif qu’aucun autre code ne nomme. Une personne l’énonce en français et en anglais (DEC-054).", "@language": "fr"}
      ]
    }
  ]
}

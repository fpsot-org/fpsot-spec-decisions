      },
      "skos:notation": "discretion",
      "skos:prefLabel": [
        {
          "@value": "Discretion",
          "@language": "en"
        },
        {
          "@value": "Pouvoir discrétionnaire",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The law leaves the case to the judgment of a person (DEC-026).",
          "@language": "en"
        },
        {
          "@value": "La loi laisse le cas au jugement d’une personne (DEC-026).",
          "@language": "fr"
        }
      ]
    },
    {
      "@id": "https://vocab.example.org/example-housing-benefit-referral-reasons/concepts/hardship",

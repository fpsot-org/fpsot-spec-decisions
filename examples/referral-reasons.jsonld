      "skos:notation": "hardship",
      "skos:prefLabel": [
        {
          "@value": "Hardship claim",
          "@language": "en"
        },
        {
          "@value": "Demande pour situation difficile",
          "@language": "fr"
        }
      ],
      "skos:definition": [
        {
          "@value": "The household claims a hardship that only a person can weigh (DEC-026).",
          "@language": "en"
        },
        {
          "@value": "Le ménage invoque une situation difficile que seule une personne peut évaluer (DEC-026).",
          "@language": "fr"
        }
      ]
    }

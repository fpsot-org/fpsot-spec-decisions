{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpsot.org/schemas/decisions/events/org.fpsot.decisions.decision.recorded.schema.json",
  "$comment": "SPDX-License-Identifier: Community-Spec-1.0. FPSOT decisions event data (DEC-072). The data holds identifiers and codes only, never the value of a fact, an amount or a name (DEC-044). The CloudEvents attributes follow API-101.",
  "title": "org.fpsot.decisions.decision.recorded",
  "description": "A decision service stored a decision record (DEC-040, DEC-072).",
  "type": "object",
  "required": [
    "decisionId",
    "decisionType",
    "decisionTypeVersion",
    "profiles",
    "impactLevel",
    "ruleSetCode",
    "ruleSetVersion",
    "resultKind",
    "reasonCodes",
    "automationDegree"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The id of the decision record, which is also the id of this event (DEC-041)."
    },
    "decisionType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The code of the decision type (DEC-010)."
    },
    "decisionTypeVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "The release of the description of the decision type (DEC-010)."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "description": "Each profile that applied, with its release (DEC-011).",
      "items": {
        "type": "object",
        "required": [
          "code",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "impactLevel": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The impact level (DEC-013)."
    },
    "ruleSetCode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The code of the rule set (DEC-030)."
    },
    "ruleSetVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "The rule version (DEC-030)."
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "decided",
        "referred",
        "insufficient-information",
        "not-applicable"
      ],
      "description": "The kind of result (DEC-024)."
    },
    "outcome": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The outcome of a decided result (DEC-024)."
    },
    "referralReason": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Why the result went to a person (DEC-026, DEC-061)."
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "The reason codes, in order of importance (DEC-052)."
    },
    "principalReasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "The principal reason codes (DEC-053)."
    },
    "automationDegree": {
      "type": "string",
      "enum": [
        "fully-automated",
        "human-confirmed",
        "human-decided"
      ],
      "description": "The degree of automation (DEC-060)."
    },
    "reviewStepIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "The review steps that led to the record (DEC-061)."
    },
    "predecessorId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The record that this one revises (DEC-043)."
    },
    "changeCause": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Why this record revises its predecessor (DEC-043)."
    }
  },
  "additionalProperties": false
}
